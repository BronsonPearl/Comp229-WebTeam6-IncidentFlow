# .env.example - placeholders only. Copy to .env and fill in. Never commit .env.
PORT=5000
NODE_ENV=development
MONGODB_URI=<your-mongodb-atlas-uri>
JWT_SECRET=<a-long-random-secret>
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Where uploaded attachments are stored (outside the repo, git-ignored)
UPLOAD_DIR=uploads
# Password for the seeded demo accounts (npm run seed). Use a dedicated demo password.
SEED_DEMO_PASSWORD=<demo-only-password>

# Optional later features (Tier 3)
# FILE_STORAGE_...=<placeholder>
# EMAIL_...=<placeholder>
# SMS_...=<placeholder>
# OAUTH_...=<placeholder>
